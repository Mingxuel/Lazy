<UserControl x:Class="MyDream.Board"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyDream"
             xmlns:oxy="http://oxyplot.org/wpf"
            xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920" Background="Black" FontFamily="Verdana">
	<UserControl.Resources>
		<local:RatioToColorConverter x:Key="RatioToColorConverter"/>
		<local:StringToPercentStringConverter x:Key="StringToPercentStringConverter"/>
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="4*"/>
		</Grid.ColumnDefinitions>
		<Grid Grid.Row="0" Grid.Column="0" >
			<GroupBox Header="UPDATE" Foreground="#FF8000" FontSize="24" FontWeight="Bold">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="130"/>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<RadioButton Grid.Row="0" Grid.Column="0" Content="SZ200" Foreground="White" VerticalContentAlignment="Center" GroupName="Tickets" Margin="10" FontWeight="Bold" IsChecked="{Binding SZ200IsSelected}"/>
						<RadioButton Grid.Row="0" Grid.Column="1" Content="ZZ500" Foreground="White" VerticalContentAlignment="Center" GroupName="Tickets" Margin="10" FontWeight="Bold" IsChecked="{Binding ZZ500IsSelected}"/>
						<Button Grid.Row="1" Grid.Column="0" Content="更新 QMT" Command="{Binding Update1DClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="1" Grid.Column="1" Content="更新1M+5M" Command="{Binding UPDATE1M5MClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="2" Grid.Column="0" Content="清除TARGET" Command="{Binding ClearTPOClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="2" Grid.Column="1" Content="更新TARGET" Command="{Binding UpdateTPOClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="3" Grid.Column="0" Content="清除TEST" Command="{Binding ClearTestingClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="3" Grid.Column="1" Content="更新TEST" Command="{Binding UpdateTestingClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="4" Grid.Column="0" Content="同步同花顺" Command="{Binding StrategyListSyncClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="4" Grid.Column="1" Content="运行时" Command="{Binding RuntimeClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<Button Grid.Row="5" Grid.Column="0" Content="更新VWAP" Command="{Binding VWAPClickCommand}" FontWeight="Bold" Height="50" Margin="10"/>
						<TextBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Output}" TextWrapping="Wrap" Background="Transparent" Foreground="White" Margin="5" FontSize="24"/>
					</Grid>
				</Grid>
			</GroupBox>
		</Grid>
		<TabControl Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Background="Black" Margin="5" >
			<TabItem Header="TARGET" FontSize="36" Width="240" Height="60" Foreground="#FF8000" FontWeight="Bold" Background="Black">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="3*"/>
						<ColumnDefinition Width="2*"/>
					</Grid.ColumnDefinitions>
					<Grid  Grid.Column="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="42"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
							<TextBlock Text="THREE" Margin="5" FontSize="30">
								<TextBlock.LayoutTransform>
									<RotateTransform Angle="90"/>
								</TextBlock.LayoutTransform>
							</TextBlock>
						</StackPanel>
						<Grid Grid.Row="0" Grid.Column="1">
							<ListBox Margin="5" ItemsSource="{Binding StrategyTarget3Data, Mode=TwoWay}" SelectedIndex="{Binding StrategyTarget3DataIndex}" Background="Black" FontSize="24" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding StockName}" Foreground="White" Width="100"/>
											<TextBlock Text="[" Foreground="White"/>
											<TextBlock Text="{Binding StockCode}" Foreground="White" Width="150"/>
											<TextBlock Text="]  " Foreground="White"/>
											<TextBlock Text="{Binding VWAPHigh}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding VWAPClose}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding Flag}" Foreground="White" Width="100"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
						<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
							<TextBlock Text="THREE+ONE" Margin="5" FontSize="30">
								<TextBlock.LayoutTransform>
									<RotateTransform Angle="90"/>
								</TextBlock.LayoutTransform>
							</TextBlock>
						</StackPanel>
						<Grid Grid.Row="1" Grid.Column="1">
							<ListBox Margin="5" ItemsSource="{Binding StrategyTarget31Data, Mode=TwoWay}" SelectedIndex="{Binding StrategyTarget31DataIndex}" Background="Black" FontSize="24" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding StockName}" Foreground="White" Width="100"/>
											<TextBlock Text="[" Foreground="White"/>
											<TextBlock Text="{Binding StockCode}" Foreground="White" Width="150"/>
											<TextBlock Text="]  " Foreground="White"/>
											<TextBlock Text="{Binding VWAPHigh}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding VWAPClose}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding Flag}" Foreground="White" Width="100"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
						<StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
							<TextBlock Text="TOP" Margin="5" FontSize="30">
								<TextBlock.LayoutTransform>
									<RotateTransform Angle="90"/>
								</TextBlock.LayoutTransform>
							</TextBlock>
						</StackPanel>
						<Grid Grid.Row="2" Grid.Column="1">
							<ListBox Margin="5" ItemsSource="{Binding StrategyTargetTopData, Mode=TwoWay}" SelectedIndex="{Binding StrategyTargetTopDataIndex}" Background="Black" FontSize="24" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding StockName}" Foreground="White" Width="100"/>
											<TextBlock Text="[" Foreground="White"/>
											<TextBlock Text="{Binding StockCode}" Foreground="White" Width="150"/>
											<TextBlock Text="]  " Foreground="White"/>
											<TextBlock Text="{Binding VWAPHigh}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding VWAPClose}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding Flag}" Foreground="White" Width="100"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
						<StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
							<TextBlock Text="TOP HISTORY" Margin="5" FontSize="30">
								<TextBlock.LayoutTransform>
									<RotateTransform Angle="90"/>
								</TextBlock.LayoutTransform>
							</TextBlock>
						</StackPanel>
						<Grid Grid.Row="3" Grid.Column="1">
							<ListBox Margin="5" ItemsSource="{Binding StrategyTargetTopHistoryData, Mode=TwoWay}" SelectedIndex="{Binding StrategyTargetTopHistoryDataIndex}" Background="Black" FontSize="24" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding StockName}" Foreground="White" Width="100"/>
											<TextBlock Text="[" Foreground="White"/>
											<TextBlock Text="{Binding StockCode}" Foreground="White" Width="150"/>
											<TextBlock Text="]  " Foreground="White"/>
											<TextBlock Text="{Binding VWAPHigh}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding VWAPClose}" Foreground="White" Width="160"/>
											<TextBlock Text="{Binding Flag}" Foreground="White" Width="100"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
					</Grid>
					<local:KChart Grid.Row="0" Grid.Column="1" KRecords="{Binding StrategyTargetKRecords}" Margin="5" Background="Black"/>
				</Grid>
			</TabItem>
			<TabItem Header="HISTORY" FontSize="30" Width="240" Height="60" Foreground="#FF8000" FontWeight="Bold" Background="Black">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="60"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="48"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
						<ComboBox Margin="5" ItemsSource="{Binding StrategyTradingDates}" SelectedIndex="{Binding StrategyTradingDatesIndex}" Width="240" FontSize="30"/>
						<Button Margin="5" Content="↑" Width="50" Command="{Binding UpClickCommand}"/>
						<Button Margin="5" Content="↓" Width="50" Command="{Binding DownClickCommand}"/>
						<RadioButton Margin="10 5 10 5" Content="0-DAY" IsChecked="{Binding StrategyIs0Day}" Foreground="White" VerticalContentAlignment="Center" FontSize="30"/>
						<RadioButton Margin="10 5 10 5" Content="1-DAY" IsChecked="{Binding StrategyIs1Day}" Foreground="White" VerticalContentAlignment="Center" FontSize="30"/>
						<RadioButton Margin="10 5 10 5" Content="5-DAY" IsChecked="{Binding StrategyIs5Day}" Foreground="White" VerticalContentAlignment="Center" FontSize="30"/>
						<RadioButton Margin="10 5 10 5" Content="10-DAY" IsChecked="{Binding StrategyIs10Day}" Foreground="White" VerticalContentAlignment="Center" FontSize="30"/>
						<RadioButton Margin="10 5 10 5" Content="20-DAY" IsChecked="{Binding StrategyIs20Day}" Foreground="White" VerticalContentAlignment="Center" FontSize="30"/>
					</StackPanel>
					<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
						<TextBlock Text="       类型" Width="250"/>
						<TextBlock Text="交易次数" Width="200"/>
						<TextBlock Text="可买票数" Width="200"/>
						<TextBlock Text="  胜率" Width="200"/>
						<TextBlock Text="单票胜率" Width="200"/>
						<TextBlock Text=" 盈亏比" Width="200"/>
					</StackPanel>
					<StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
						<TextBlock Text="  CLOSE卖出" Width="200"/>
						<TextBlock Text="{Binding StrategySellCloseCount}" Width="200" Padding="60 0 60 0"/>
						<TextBlock Text="{Binding StrategyPerSellCount}" Width="200" Padding="55 0 55 0"/>
						<TextBlock Text="{Binding StrategySellCloseWin}" Width="200" Padding="25 0 25 0"/>
						<TextBlock Text="{Binding StrategyPerSellCloseWin}" Width="200" Padding="30 0 30 0"/>
						<TextBlock Text="{Binding StrategySellCloseRatio}" Width="290" Padding="10 0 10 0"/>
					</StackPanel>
					<StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
						<TextBlock Text="  OPEN卖出" Width="200"/>
						<TextBlock Text="{Binding StrategySellOpenCount}" Width="200" Padding="60 0 60 0"/>
						<TextBlock Text="{Binding StrategyPerSellCount}" Width="200" Padding="55 0 55 0"/>
						<TextBlock Text="{Binding StrategySellOpenWin}" Width="200" Padding="25 0 25 0"/>
						<TextBlock Text="{Binding StrategyPerSellOpenWin}" Width="200" Padding="30 0 30 0"/>
						<TextBlock Text="{Binding StrategySellOpenRatio}" Width="200" Padding="10 0 10 0"/>
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
						<TextBlock Text="  HIGH卖出" Width="200"/>
						<TextBlock Text="{Binding StrategySellHighCount}" Width="200" Padding="60 0 60 0"/>
						<TextBlock Text="{Binding StrategyPerSellCount}" Width="200" Padding="55 0 55 0"/>
						<TextBlock Text="{Binding StrategySellHighWin}" Width="200" Padding="25 0 25 0"/>
						<TextBlock Text="{Binding StrategyPerSellHighWin}" Width="200" Padding="30 0 30 0"/>
						<TextBlock Text="{Binding StrategySellHighRatio}" Width="200" Padding="10 0 10 0"/>
					</StackPanel>
					<StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="5 10 5 0">
						<TextBlock Text="NAME" Width="120" FontSize="24" Margin="26 0 0 0"/>
						<TextBlock Text="CODE" Width="160" FontSize="24" Margin="40 0 0 0"/>
						<TextBlock Text="CLOSE" Width="160" FontSize="24" Margin="10 0 0 0"/>
						<TextBlock Text="HIGH" Width="160" FontSize="24" Margin="10 0 0 0"/>
						<TextBlock Text="LOW" Width="160" FontSize="24" Margin="5 0 0 0"/>
						<TextBlock Text="OPEN" Width="120" FontSize="24"/>
						<TextBlock Text="VW-HIGH" Width="160" FontSize="24" Margin="5 0 0 0"/>
						<TextBlock Text="VW-CLOSE" Width="160" FontSize="24" Margin="5 0 0 0"/>
					</StackPanel>
					<Grid Grid.Row="6" Grid.Column="0">
						<ListBox Margin="5" ItemsSource="{Binding StrategyData}" SelectedIndex="{Binding StrategyDataIndex}" FontSize="24" Background="Black">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding StockName}" Foreground="White" Width="120" Margin="10 0 0 0"/>
										<TextBlock Text="[" Foreground="White"/>
										<TextBlock Text="{Binding StockCode}" Foreground="White" Width="150"/>
										<TextBlock Text="]   " Foreground="White"/>
										<TextBlock Text="{Binding CloseRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding HighRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding LowRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding OpenRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding VWAPHighRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding VWAPCloseRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>
					<local:KChart Grid.Row="7" Grid.Column="0" KRecords="{Binding StrategyKRecords}" Margin="5" Background="Black"/>
				</Grid>
			</TabItem>
			<TabItem Header="TOTAL" Width="240" Height="60" Foreground="#FF8000" FontWeight="Bold" FontSize="36" Background="Black">
				<Grid>
					<TabControl Grid.Row="7" Grid.Column="0" Background="Black" FontWeight="Bold" FontSize="36" Margin="5">
						<TabItem Header="CLOSE" Foreground="#FF8000" Background="Black" FontWeight="Bold" FontSize="36" Width="150" Height="60">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="320"/>
									<ColumnDefinition Width="1"/>
									<ColumnDefinition/>
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition/>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition Width="48"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
									</Grid.RowDefinitions>
									<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="YEAR" HorizontalAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CloseYearMinusClickCommand}"/>
									<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding CloseYear}" HorizontalAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CloseYearPlusClickCommand}"/>
									<TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Text="MONTH" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CloseMonthMinusClickCommand}"/>
									<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding CloseMonth}" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CloseMonthPlusClickCommand}"/>
								</Grid>
								<Grid Grid.Column="1" Background="White"/>
								<Grid Grid.Column="2">
									<ListBox Margin="5" ItemsSource="{Binding DisCloseData}" Background="Black" FontSize="30" FontWeight="Bold" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="{Binding Name}" Width="320" Foreground="White"/>
													<TextBlock Text="{Binding Count}" Width="100" Foreground="White"/>
													<Rectangle Fill="#FF8000" Width="{Binding Count}" Margin="10 1 0 1" Height="30">
														<Rectangle.RenderTransform>
															<ScaleTransform ScaleX="{x:Static local:Constants.ScaleX}"/>
														</Rectangle.RenderTransform>
													</Rectangle>
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</Grid>
							</Grid>
						</TabItem>
						<TabItem Header="OPEN" Foreground="#FF8000" FontWeight="Bold" Background="Black" FontSize="36" Width="120" Height="60">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="320"/>
									<ColumnDefinition Width="1"/>
									<ColumnDefinition/>
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition/>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition Width="48"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
									</Grid.RowDefinitions>
									<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="YEAR" HorizontalAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenYearMinusClickCommand}"/>
									<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding OpenYear}" HorizontalAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenYearPlusClickCommand}"/>
									<TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Text="MONTH" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenMonthMinusClickCommand}"/>
									<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding OpenMonth}" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenMonthPlusClickCommand}"/>
								</Grid>
								<Grid Grid.Column="1" Background="White"/>
								<Grid Grid.Column="2">
									<ListBox Margin="5" ItemsSource="{Binding DisOpenData}" Background="Black" FontSize="30" FontWeight="Bold" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="{Binding Name}" Width="320" Foreground="White"/>
													<TextBlock Text="{Binding Count}" Width="100" Foreground="White"/>
													<Rectangle Fill="#FF8000" Width="{Binding Count}" Margin="10 1 0 1" Height="30">
														<Rectangle.RenderTransform>
															<ScaleTransform ScaleX="{x:Static local:Constants.ScaleX}"/>
														</Rectangle.RenderTransform>
													</Rectangle>
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</Grid>
							</Grid>
						</TabItem>
						<TabItem Header="HIGH" Foreground="#FF8000" FontWeight="Bold" Background="Black" FontSize="36" Width="120" Height="60">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="320"/>
									<ColumnDefinition Width="1"/>
									<ColumnDefinition/>
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition/>
										<ColumnDefinition Width="48"/>
										<ColumnDefinition Width="48"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
										<RowDefinition Height="48"/>
									</Grid.RowDefinitions>
									<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="YEAR" HorizontalAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding HighYearMinusClickCommand}"/>
									<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding HighYear}" HorizontalAlignment="Center"/>
									<Button Grid.Row="2" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding HighYearPlusClickCommand}"/>
									<TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Text="MONTH" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding HighMonthMinusClickCommand}"/>
									<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding HighMonth}" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding HighMonthPlusClickCommand}"/>
								</Grid>
								<Grid Grid.Column="1" Background="White"/>
								<Grid Grid.Column="2">
									<ListBox Margin="5" ItemsSource="{Binding DisHighData}" Background="Black" FontSize="30" FontWeight="Bold" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="{Binding Name}" Width="320" Foreground="White"/>
													<TextBlock Text="{Binding Count}" Width="100" Foreground="White"/>
													<Rectangle Fill="#FF8000" Width="{Binding Count}" Margin="10 1 0 1" Height="30">
														<Rectangle.RenderTransform>
															<ScaleTransform ScaleX="{x:Static local:Constants.ScaleX}"/>
														</Rectangle.RenderTransform>
													</Rectangle>
												</StackPanel>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</Grid>
							</Grid>
						</TabItem>
						<TabItem Header="2024" Foreground="#FF8000" FontWeight="Bold" Background="Black" FontSize="36" Width="120" Height="60">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="48"/>
									<RowDefinition Height="Auto"/>
