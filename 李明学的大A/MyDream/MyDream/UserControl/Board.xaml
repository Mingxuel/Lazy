									<Button Grid.Row="5" Grid.Column="1" Content="-" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CalenderMonthMinusClickCommand}"/>
									<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding CalendarMonth}" HorizontalAlignment="Center"/>
									<Button Grid.Row="5" Grid.Column="3" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CalenderMonthPlusClickCommand}"/>
								</Grid>
								<Grid Grid.Column="1" Background="White"/>
								<ItemsControl Grid.Column="2" ItemsSource="{Binding CalendarDatas}" Foreground="#FF8000">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal" Margin="7 3 0 0"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="#000000" BorderBrush="#FFFFFF" Width="272" Height="120" BorderThickness="1" CornerRadius="5" Padding="10" Margin="10">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="72"/>
														<ColumnDefinition Width="1"/>
														<ColumnDefinition/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0" Text="{Binding Day}" FontSize="42" FontWeight="Bold" Foreground="#FF8000" VerticalAlignment="Center"/>
													<Grid Grid.Column="1" Background="White"/>
													<Grid Grid.Column="2" Margin="20 0 0 0" VerticalAlignment="Center">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="36"/>
															<ColumnDefinition/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition/>
															<RowDefinition/>
															<RowDefinition/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Grid.Column="0" Text="C:" FontSize="28" Foreground="#E0E0E0"/>
														<TextBlock Grid.Row="1" Grid.Column="0" Text="O:" FontSize="28" Foreground="#E0E0E0"/>
														<TextBlock Grid.Row="2" Grid.Column="0" Text="H:" FontSize="28" Foreground="#E0E0E0"/>
														<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CloseRatio}" FontSize="28" Foreground="{Binding CloseRatio, Converter={StaticResource RatioToColorConverter}}"/>
														<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OpenRatio}" FontSize="28" Foreground="{Binding OpenRatio, Converter={StaticResource RatioToColorConverter}}"/>
														<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HighRatio}" FontSize="28" Foreground="{Binding HighRatio, Converter={StaticResource RatioToColorConverter}}"/>
													</Grid>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Grid>
						</TabItem>
<!--					<TabItem Header="BURN" Foreground="#FF8000" FontWeight="Bold" Background="Black" FontSize="36" Width="120" Height="60">
							<Grid Margin="3">
								<Image Source="{Binding BurnAll}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased"/>
							</Grid>
						</TabItem>!-->
						<TabItem Header="BURN" Foreground="#FF8000" FontWeight="Bold" Background="Black" FontSize="36" Width="120" Height="60">
							<Grid>
								<ListBox ItemsSource="{Binding BurnChart}" Background="Black" FontSize="30" FontWeight="Bold" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
									<ListBox.ItemContainerStyle>
										<Style TargetType="ListBoxItem">
											<Setter Property="Height" Value="10"/>
											<Setter Property="Padding" Value="0"/>
										</Style>
									</ListBox.ItemContainerStyle>
									<ListBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal">
												<TextBlock Foreground="#FF8000" Text="{Binding Time}" Margin="5 0 5 0" FontSize="6" Width="60"/>
												<TextBlock Foreground="#FF8000" Text="{Binding Count}" Margin="5 0 5 0" FontSize="6" Width="40"/>
												<Rectangle Fill="#FF8000" Width="{Binding Count}" Margin="5 0 0 0" Height="6">
												</Rectangle>
											</StackPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</Grid>
						</TabItem>
					</TabControl>
				</Grid>
			</TabItem>
			<TabItem Header="RATIO" FontSize="36" Width="240" Height="60" Foreground="#FF8000" FontWeight="Bold" Background="Black">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="48"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Text="RANDOM 1" Margin="5,5,5,4" FontSize="30">
						<TextBlock.LayoutTransform>
							<RotateTransform Angle="90"/>
						</TextBlock.LayoutTransform>
					</TextBlock>
					<ListBox Grid.Row="0" Grid.Column="1" Margin="3,5,3,4" ItemsSource="{Binding StrategyDetail1}" Background="Black" VerticalContentAlignment="Center" FontSize="24">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding ID}" Foreground="White" Width="100"/>
									<TextBlock Text="{Binding Detail2024}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding Detail2025}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding Detail2026}" Foreground="White" Width="180"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<TextBlock Grid.Row="1" Grid.Column="0" Text="RANDOM 2" Margin="5,6,5,5" FontSize="30">
						<TextBlock.LayoutTransform>
							<RotateTransform Angle="90"/>
						</TextBlock.LayoutTransform>
					</TextBlock>
					<ListBox Grid.Row="1" Grid.Column="1" Margin="3,6,3,5" ItemsSource="{Binding StrategyDetail2}" Background="Black" VerticalContentAlignment="Center" FontSize="24">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding ID}" Foreground="White" Width="100"/>
									<TextBlock Text="{Binding Detail2024}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding Detail2025}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding Detail2026}" Foreground="White" Width="180"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<TextBlock Grid.Row="2" Grid.Column="0" Text="VWAP" Margin="5,5,5,6" FontSize="30">
						<TextBlock.LayoutTransform>
							<RotateTransform Angle="90"/>
						</TextBlock.LayoutTransform>
					</TextBlock>
					<ListBox Grid.Row="2" Grid.Column="1" Margin="3,5,3,6" ItemsSource="{Binding StrategyDetailVWAP}" Background="Black" VerticalContentAlignment="Center" FontSize="24">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding ID}" Foreground="White" Width="100"/>
									<TextBlock Text="{Binding Detail2024}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding Detail2025}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding Detail2026}" Foreground="White" Width="180"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<TextBlock Grid.Row="3" Grid.Column="0" Text="VWAP TICKETS" Margin="5,4,5,5" FontSize="30">
						<TextBlock.LayoutTransform>
							<RotateTransform Angle="90"/>
						</TextBlock.LayoutTransform>
					</TextBlock>
					<Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5">
						<Grid.RowDefinitions>
							<RowDefinition Height="30"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<StackPanel Grid.Row="0" Orientation="Horizontal">
							<TextBlock Text="      DATE" Width="150" Foreground="White" FontSize="20"/>
							<TextBlock Text="    NAME" Width="100" Foreground="White" FontSize="20"/>
							<TextBlock Text="         CODE" Width="190" Foreground="White" FontSize="20"/>
							<TextBlock Text="RATIO CLOSE" Width="160" Foreground="White" FontSize="20"/>
							<TextBlock Text="RATIO HIGH" Width="160" Foreground="White" FontSize="20"/>
							<TextBlock Text="RATIO LOW" Width="160" Foreground="White" FontSize="20"/>
							<TextBlock Text="RATIO OPEN" Width="160" Foreground="White" FontSize="20"/>
							<TextBlock Text="VWAP HIGH" Width="160" Foreground="White" FontSize="20"/>
							<TextBlock Text="VWAP CLOSE" Width="160" Foreground="White" FontSize="20"/>
						</StackPanel>
						<ListBox Grid.Row="1" ItemsSource="{Binding StrategyDetailVWAPTickets}" SelectedIndex="{Binding StrategyDetailVWAPTicketsIndex}" Background="Black" VerticalContentAlignment="Center" FontSize="24">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding Date}" Width="150" Foreground="White"/>
										<TextBlock Text="{Binding StockName}" Foreground="White" Width="100"/>
										<TextBlock Text="[" Foreground="White"/>
										<TextBlock Text="{Binding StockCode}" Foreground="White" Width="150"/>
										<TextBlock Text="]  " Foreground="White"/>
										<TextBlock Text="{Binding CloseRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding HighRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding LowRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding OpenRatio, Converter={StaticResource StringToPercentStringConverter}}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding VWAPHigh}" Foreground="White" Width="160"/>
										<TextBlock Text="{Binding VWAPClose}" Foreground="White" Width="160"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>
					<local:KChart Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" KRecords="{Binding StrategyDetailKRecords}" Margin="5" Background="Black"/>
				</Grid>
			</TabItem>
			<TabItem Header="MOTION" FontSize="36" Width="240" Height="60" Foreground="#FF8000" FontWeight="Bold" Background="Black">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="48"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Text="MOTION 1" Margin="5,5,5,4" FontSize="30">
						<TextBlock.LayoutTransform>
							<RotateTransform Angle="90"/>
						</TextBlock.LayoutTransform>
					</TextBlock>
					<ListBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="3,5,3,4" ItemsSource="{Binding MotionData}" Background="Black" VerticalContentAlignment="Center" FontSize="24">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding Date}" Foreground="White" Width="160"/>
									<TextBlock Text="{Binding StockCode}" Foreground="White" Width="160"/>
									<TextBlock Text="{Binding StockName}" Foreground="White" Width="160"/>
									<TextBlock Text="{Binding DAY1}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding DAY2}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding DAY3}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding DAY4}" Foreground="White" Width="180"/>
									<TextBlock Text="{Binding DAY5}" Foreground="White" Width="180"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<local:KChart Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" KRecords="{Binding StrategyDetailKRecords}" Margin="5" Background="Black"/>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
