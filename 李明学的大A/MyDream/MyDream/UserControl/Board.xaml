						</Grid>
						<StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
							<TextBlock Text="TOP" Width="200"/>
						</StackPanel>
						<Grid Grid.Row="3" Grid.Column="0">
							<ListBox Margin="5" ItemsSource="{Binding StrategyTargetTopData, Mode=TwoWay}" SelectedIndex="{Binding StrategyTargetTopDataIndex}" Background="Black" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding StockName}" Width="40" Foreground="White" FontSize="9"/>
											<TextBlock Text="[" Foreground="White" FontSize="10"/>
											<TextBlock Text="{Binding StockCode}" Foreground="White" FontSize="9"/>
											<TextBlock Text="]  " Foreground="White" FontSize="10"/>
											<TextBlock Text="{Binding Slope}" Foreground="White" Width="55" FontSize="9"/>
											<TextBlock Text="{Binding SlopeRatio}" Foreground="White" Width="60" FontSize="9"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
						<StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
							<TextBlock Text="TOP HISTORY" Width="200"/>
						</StackPanel>
						<Grid Grid.Row="3" Grid.Column="2">
							<ListBox Margin="5" ItemsSource="{Binding StrategyTargetTopHistoryData, Mode=TwoWay}" SelectedIndex="{Binding StrategyTargetTopHistoryDataIndex}" Background="Black" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding StockName}" Width="40" Foreground="White" FontSize="9"/>
											<TextBlock Text="[" Foreground="White" FontSize="10"/>
											<TextBlock Text="{Binding StockCode}" Foreground="White" FontSize="9"/>
											<TextBlock Text="]  " Foreground="White" FontSize="10"/>
											<TextBlock Text="{Binding Slope}" Foreground="White" Width="55" FontSize="9"/>
											<TextBlock Text="{Binding SlopeRatio}" Foreground="White" Width="60" FontSize="9"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Grid>
					</Grid>
					<local:KChart Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" KRecords="{Binding StrategyTargetKRecords}" Margin="5" Background="Black"/>
				</Grid>
			</TabItem>
			<TabItem Header="TREND SET" FontSize="14" Width="100" Height="30" Foreground="#FF8000" FontWeight="Bold" Background="Black" Visibility="Hidden">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="560"/>
						<ColumnDefinition/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="48"/>
						<RowDefinition/>
					</Grid.RowDefinitions>
					<StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" >
						<TextBlock Text="股票名称:" VerticalAlignment="Center"/>
						<ComboBox Margin="5" Width="90" ItemsSource="{Binding TrendStockCodes}" SelectedIndex="{Binding TrendStockCodeIndex}"/>
						<TextBlock Text=" 开始:" VerticalAlignment="Center"/>
						<ComboBox Margin="5" Width="110" ItemsSource="{Binding TrendBeginDate}" SelectedIndex="{Binding TrendBeginDateIndex}"/>
						<TextBlock Text=" 结束:" VerticalAlignment="Center"/>
						<ComboBox Margin="5" Width="110" ItemsSource="{Binding TrendEndDate}" SelectedIndex="{Binding TrendEndDateIndex}"/>
						<Button Width="60" Content="ADD" Margin="10 5 5 5" Command="{Binding AddTrendClickCommand}"/>
					</StackPanel>
					<ListBox Grid.Row="1" Grid.Column="0" Margin="3 5 3 5" ItemsSource="{Binding TrendData}" SelectedIndex="{Binding TrendDataIndex}" Background="Black" VerticalContentAlignment="Center">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding StockName}" Width="100" Foreground="White"/>
									<TextBlock Text="{Binding StockCode}" Foreground="White" Width="100"/>
									<TextBlock Text="{Binding BeginDate}" Foreground="White" Width="120"/>
									<TextBlock Text="{Binding EndDate}" Foreground="White" Width="120"/>
									<Button Content="DELETE" Command="{Binding DataContext.DeleteTrendClickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
							CommandParameter="{Binding}" Width="100"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<local:KChart Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" KRecords="{Binding TrendKRecords}" Margin="5"/>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
