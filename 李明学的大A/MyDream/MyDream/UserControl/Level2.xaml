<UserControl x:Class="MyDream.Level2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyDream"
        mc:Ignorable="d"
        Background="Black" d:DesignWidth="960" d:DesignHeight="960"  Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="49"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="DAYS" VerticalAlignment="Center" FontSize="45" FontWeight="Bold" Foreground="White"/>
        <TextBox x:Name="tb_days" Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Background="Black" Foreground="White" TextWrapping="WrapWithOverflow" Margin="3 1 3 0" IsReadOnly="False" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" AcceptsReturn="True" Width="140"/>
        <Button Grid.Row="4" Grid.Column="0" Margin="4 6 4 9" Content="LOAD" FontWeight="Bold" FontSize="24" Click="LoadClick"/>
        <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Header="2F" FontSize="45" FontWeight="Bold" Foreground="White" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_0_0" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_0_0" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_0_0_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_0_0" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="2" Header="2F+1" FontSize="45" FontWeight="Bold" Foreground="White" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_0_1" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_0_1" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_0_1_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_0_1" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Header="2F+2" FontSize="45" FontWeight="Bold" Foreground="White" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_0_2" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_0_2" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_0_2_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_0_2" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Header="2S" FontSize="45" FontWeight="Bold" Foreground="White" Margin="5 0 5 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_1_0" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_1_0" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_1_0_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_1_0" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="3" Header="2S+1" FontSize="45" FontWeight="Bold" Foreground="White" Margin="5 0 5 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_1_1" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_1_1" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_1_1_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_1_1" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" Header="2S+2" FontSize="45" FontWeight="Bold" Foreground="White" Margin="5 0 5 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_1_2" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_1_2" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_1_2_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_1_2" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
