RCD_H_1:=H;
RCD_V_1:=V;
RCD_C_1:=C;
RCD_H_2:=REF(H,1);
RCD_V_2:=REF(V,1);
RCD_H_3:=REF(H,2);
RCD_V_3:=REF(V,2);
RCD_H_4:=REF(H,3);
RCD_V_4:=REF(V,3);
TOTAL_VALUE := RCD_H_1*RCD_V_1 + RCD_H_2*RCD_V_2 + RCD_H_3*RCD_V_3 + RCD_H_4*RCD_V_4;
TOTAL_VOLUME := RCD_V_1 + RCD_V_2 + RCD_V_3 + RCD_V_4;
VWAP_VALUE := TOTAL_VALUE / TOTAL_VOLUME;
VWAP := (VWAP_VALUE - RCD_C_1) / RCD_C_1;
POLYLINE(1, VWAP), colorwhite, LINETHICK2;
DRAWTEXT_FIX(1,0.01,0.02,0,'自定义指标：'+ROUND(VWAP*100)),coloryellow,LINETHICK2;