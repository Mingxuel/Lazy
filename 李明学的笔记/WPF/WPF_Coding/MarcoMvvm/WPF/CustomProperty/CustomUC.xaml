<UserControl x:Class="MarcoMVVM.CustomUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             BorderThickness="1" BorderBrush="Black"
             d:DesignWidth="500" d:DesignHeight="100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding TextValue1, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="40" Margin="5"/>
        <TextBox Grid.Column="1" Text="{Binding TextValue2, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="40" Margin="5"/>
        <Button  Grid.Column="2" Content="Click" Height="40" Margin="5" Command="{Binding ButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
