<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MarcoMVVM</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Manual\BindingManualCollection\UC_BindingManualCollection.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Manual\BindingManualConverter\UC_BindingManualConverter.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Manual\BindingManualMultiConverter\UC_BindingManualMultiConverter.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Manual\BindingRelativeSource\UC_BindingRelativeSource.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Manual\BindingAnotherControl\UC_BindingAnotherControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Manual\BindingStatic\UC_BindingStatic.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Properties\Lang.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Lang.resx</DependentUpon>
    </Compile>
    <Compile Update="Toolkit\BindingMessangerRequest\UC_BindingMessangerRequestReceiver.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Toolkit\BindingMessangerRequest\UC_BindingMessangerRequestSender.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Toolkit\BindingMessangerProperty\UC_BindingMessangerPropertyReceiver.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Toolkit\BindingMessangerProperty\UC_BindingMessangerPropertySender.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Lang.resx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Lang.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Lang.zh-CN.resx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
