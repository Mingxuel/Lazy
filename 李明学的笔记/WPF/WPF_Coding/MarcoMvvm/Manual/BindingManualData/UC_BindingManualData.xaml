<UserControl x:Class="MarcoMVVM.UC_BindingManualData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             Width="450" Height="200" BorderThickness="1" BorderBrush="Black">
    <UserControl.DataContext>
        <local:BindingManualDataViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="TextBox的Text与MarcoInput进行了绑定，并且在MarcoInput的set里与MarcoOutput进行了联系" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Foreground="White"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="INPUT TEXT:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MarcoInput, UpdateSourceTrigger=PropertyChanged}" Height="40"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Path=MarcoOutput}" Height="40" Margin="0" VerticalAlignment="Center" Foreground="White"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MarcoOutput}" Height="40" Margin="0" VerticalAlignment="Center" Foreground="White"/>
    </Grid>
</UserControl>
