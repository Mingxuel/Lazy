<UserControl x:Class="MarcoMVVM.UC_BindingEventCommand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             Width="450" Height="200" BorderThickness="1" BorderBrush="Black">
    <UserControl.DataContext>
        <local:BindingEventCommandViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="TextBox的PreviewMouseDown事件与TextClickCommand进行了Binding" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" x:Name="input"/>
        <TextBox Grid.Row="1" Grid.Column="2" Margin="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextWrapping="Wrap">
            <TextBox.Text>
                我不能是Button
                我只能是TextBox
            </TextBox.Text>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseDown">
                    <i:InvokeCommandAction Command="{Binding TextClickCommand}" CommandParameter="{Binding ElementName=input, Path=Text}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
    </Grid>
</UserControl>
