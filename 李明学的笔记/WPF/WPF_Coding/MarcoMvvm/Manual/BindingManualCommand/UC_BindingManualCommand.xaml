<UserControl x:Class="MarcoMVVM.UC_BindingManualCommand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             Width="450" Height="200" BorderThickness="1" BorderBrush="Black">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="textBox1" Text="{Binding ID}" Height="40" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="textBox2" Text="{Binding NAME}" Height="40" Margin="5"/>
        <Button Grid.Row="2" Grid.Column="1" Content="无参函数" Command="{Binding NoParamCommand}" Height="40" Margin=" 10" VerticalAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="2" Content="有参参数" Command="{Binding ParamCommand}" CommandParameter="{Binding ElementName=textBox1, Path=Text}" Height="40" Margin="10" VerticalAlignment="Center"/>
        <Button Grid.Row="3" Grid.Column="1" Content="泛型函数" Command="{Binding TemplateParamCommand}" CommandParameter="{Binding ElementName=textBox1, Path=Text}" Height="40" Margin="10" VerticalAlignment="Center"/>
        <Button Grid.Row="3" Grid.Column="2" Content="泛型多参参数" Command="{Binding TemplateMultiParamCommand}" Height="40" Margin="10" VerticalAlignment="Center">
            <Button.Resources>
                <local:BindingManualCommandConverter x:Key="BindingManualCommandConverter"/>
            </Button.Resources>
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource BindingManualCommandConverter}">
                    <Binding ElementName="textBox1" Path="Text"/>
                    <Binding ElementName="textBox2" Path="Text"/>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>
    </Grid>
</UserControl>
