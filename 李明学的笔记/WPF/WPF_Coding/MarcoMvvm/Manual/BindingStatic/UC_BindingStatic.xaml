<UserControl x:Class="MarcoMVVM.UC_BindingStatic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             Width="500" Height="200" BorderThickness="1" BorderBrush="Black">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SolidColor" Color="Red"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="TextBox绑定了UserControl.Resources定义的SolidColorBrush" TextWrapping="Wrap" Margin="20 20 0 0" FontSize="16" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource SolidColor}"/>
    </Grid>
</UserControl>
