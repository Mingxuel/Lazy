<UserControl x:Class="MarcoMVVM.UC_Validation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             Width="450" Height="400" BorderThickness="1" BorderBrush="Black">
    <UserControl.DataContext>
        <local:ValidationViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="Toolkit极大的简化了MVVM结构" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" Foreground="White"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" Foreground="White"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" Foreground="White"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Age:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Username}" Height="40"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Email}" Height="40" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Height="40"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessages, UpdateSourceTrigger=PropertyChanged}" Foreground="Red" Height="100" Margin="5"/>
        <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Command="{Binding RegisterCommand}" Height="40" Content="Register" Margin="5 5 5 0" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
