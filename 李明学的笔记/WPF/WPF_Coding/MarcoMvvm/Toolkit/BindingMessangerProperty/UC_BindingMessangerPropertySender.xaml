<UserControl x:Class="MarcoMVVM.UC_BindingMessangerPropertySender"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:BindingMessangerPropertySenderViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <CheckBox Grid.Row="0" Margin="5" Content="Token A" IsChecked="{Binding IsTokenAEnabled}" />
        <CheckBox Grid.Row="1" Margin="5" Content="Token B" IsChecked="{Binding IsTokenBEnabled}" />
        <TextBox Grid.Row="2" Margin="5" Text="{Binding SendMessage, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
